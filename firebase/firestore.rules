rules_version = '2';

// Each signed-in user can only read/write their own data under users/{uid}.
// Used by both the web app (chianghebe.com) and the mobile app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public Chiangverse shooter leaderboard: anyone can read; writes must stay a
    // capped { scores: [...] } array so the doc can't be abused as open storage.
    match /public/cv_shooter {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['scores'])
                   && request.resource.data.scores is list
                   && request.resource.data.scores.size() <= 20;
    }
  }
}
